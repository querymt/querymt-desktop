{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "QueryMT Desktop",
    "version": "0.1.10",
    "identifier": "com.querymt.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build",
        "devUrl": "http://localhost:5173"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "QueryMT Desktop",
                "width": 1440,
                "height": 960,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "decorations": true,
                "shadow": true,
                "transparent": true
            }
        ]
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": [
            "app",
            "dmg",
            "nsis",
            "appimage",
            "deb"
        ],
        "category": "DeveloperTool",
        "publisher": "QueryMT",
        "shortDescription": "Native desktop control center for QueryMT.",
        "longDescription": "QueryMT Desktop is a native Tauri application for managing QueryMT agents, sessions, logs, and workspaces.",
        "icon": [
            "icons/32x32.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMkNFNTAzRTcwMjM2RjMKUldUek5nTG5BK1VzWVVyUFViUDFnNHFVM3BuN2pybEMwMFVkakc4WGdCcjdLV3hkbUl3cVV3dEIK",
            "requireSignedVersion": true
        }
    }
}
